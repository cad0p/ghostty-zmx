	# https://www.vrdmn.com/2023/11/manage-azure-openai-service-using-azure.html
	# if this fails, run `az login`
	export AZURE_API_BASE=$(az cognitiveservices account show --name PierAI --resource-group Annual --query properties.endpoint | sed -e 's/^"//' -e 's/"$//')
	export AZURE_API_VERSION=2024-06-01
	export AZURE_API_KEY=$(az cognitiveservices account keys list --name PierAI --resource-group Annual --query key1 | sed -e 's/^"//' -e 's/"$//')
	# Start Aider with any passed arguments
  command aider "$@"
}

