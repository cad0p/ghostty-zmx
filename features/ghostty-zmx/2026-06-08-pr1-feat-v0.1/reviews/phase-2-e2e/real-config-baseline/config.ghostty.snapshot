theme = dark: Ghostty Default Style Dark, light:Alabaster
keybind = alt+backspace=text:\x1b\x7f
keybind = super+bracket_left=previous_tab
keybind = super+bracket_right=next_tab
keybind = super+alt+l=previous_tab
keybind = super+alt+r=next_tab
keybind = super+alt+arrow_left=goto_split:previous
keybind = super+alt+arrow_right=goto_split:next
unfocused-split-opacity = 0.4
keybind = super+alt+shift+arrow_left=move_tab:-1
keybind = super+alt+shift+arrow_right=move_tab:1
keybind = super+alt+shift+l=move_tab:-1
keybind = super+alt+shift+r=move_tab:1

# BEGIN ghostty-zmx
# Managed by ghostty-zmx. Re-run the installer to update this block.
env = GHOSTTY_ZMX_AUTO_ATTACH=1
env = GHOSTTY_ZMX_DEBUG=1
confirm-close-surface = true
# END ghostty-zmx
