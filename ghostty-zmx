#!/bin/zsh -f
# ghostty-zmx CLI — v0.2 projection wrapper.
# -f: skip rc files so the wrapper never sources .zprofile/.zshrc (and thus never
# sources session-manager.zsh). Without -f, Ghostty runs the command via
# `login -c "exec -l <cmd>"` and `exec -l` makes it a login shell, which sources
# .zprofile → session-manager.zsh, re-running auto-attach/widget/poller inside
# the projection pane and causing window multiplication.
#
# Usage:
#   ghostty-zmx projection --host <host> --workspace <ws> --session <gzr> -- <transport...> 'zmx attach <gzr>'
#
# The wrapper stays alive as the parent of the transport command so that
# ghostty-zmx can observe and clean up projections by process args. It sets
# env markers (GHOSTTY_ZMX_PROJECTION*) and an OSC window title, runs the
# transport as a child, forwards termination signals, and exits with the
# child's status. The generic CLI name is intentional so v0.3 can extend it
# with workspace attach/detach/list commands without a second binary.
#
# This is sourced/launched as a surface `command` by ghostty-zmx; it never
# sources .zshrc or runs a local shell, so local auto-attach is bypassed.

emulate -L zsh
setopt no_sh_word_split

# Debug logging to the state debug.log (mirrors the manager's _ghostty_zmx_debug).
_gzmx_wdebug() {
  [[ "${GHOSTTY_ZMX_DEBUG:-0}" == "1" ]] || return 0
  local _d="${GHOSTTY_ZMX_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/ghostty-zmx}"
  mkdir -p "$_d" 2>/dev/null
  print -r -- "$(date -u '+%Y-%m-%dT%H:%M:%SZ') wrapper $*" >> "$_d/debug.log"
}

# ghostty-zmx install-server <host> [-- yes]
# ghostty-zmx install-server -- <transport...> <host>
#
# One-shot server-side bootstrap. Bundles the four files install-server.sh
# needs as siblings (session-manager.zsh, session-manager-lib.zsh,
# ghostty-zmx-remote-layout, terminfo/xterm-ghostty.terminfo) from the local
# install dir, streams the tarball over the no-pty transport into a temp dir
# on the remote, runs install-server.sh --yes there, and cleans up.
#
# Transport resolution:
#   - Explicit form: `install-server -- tsh ssh -i key pier@host`
#     Everything after `--` is the transport argv; the last token is the host.
#   - Known host: `install-server pcad-dev` looks up the stored prefix in
#     remote-hosts (so tsh vs ssh and any ssh options are reused). Falls back
#     to `ssh <host>` if not found.
#   - Bare host: `install-server pier@host` uses `ssh pier@host`.
#
# Streams the remote installer's stdout/stderr to the local terminal and exits
# with the remote installer's exit status. Never sources .zshrc; runs under
# `zsh -f` like the rest of the wrapper.
_gzmx_install_server() {
  emulate -L zsh
  setopt local_options no_sh_word_split extended_glob

  local install_dir="${GHOSTTY_ZMX_INSTALL_DIR:-$HOME/.config/ghostty-zmx}"
  local data_home="${GHOSTTY_ZMX_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/ghostty-zmx}"
  local hosts_file="$data_home/remote-hosts"

  local -a transport_argv host_target
  local yes=0

  if [[ "$#" -gt 0 && "$1" == "--" ]]; then
    shift
    (( $# > 0 )) || { print -u2 "ghostty-zmx install-server: transport command missing after --"; return 2 }
    transport_argv=("$@")
    host_target="${transport_argv[-1]}"
  else
    # Parse flags then host. Only --yes/-y is supported; everything else is the host.
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --yes|-y) yes=1; shift ;;
        --) shift; (( $# > 0 )) || { print -u2 "ghostty-zmx install-server: host missing after --"; return 2 }; host_target="$1"; transport_argv=(ssh "$1"); shift ;;
        -*) print -u2 "ghostty-zmx install-server: unknown option $1"; return 2 ;;
        *) host_target="$1"; shift ;;
      esac
    done
    [[ -n "$host_target" ]] || { print -u2 "ghostty-zmx install-server: host argument required"; return 2 }
    # Look up stored prefix if the host is known, else plain ssh.
    local stored_prefix=""
    [[ -f "$hosts_file" ]] && stored_prefix="$(awk -F '\t' -v host="$host_target" '$1 == host { print $5; exit }' "$hosts_file" 2>/dev/null)"
    if [[ -n "$stored_prefix" ]]; then
      transport_argv=(${(z)stored_prefix})
    else
      transport_argv=(ssh "$host_target")
    fi
  fi

  [[ -n "$host_target" ]] || { print -u2 "ghostty-zmx install-server: could not determine host from transport"; return 2 }

  # Verify the local bundle files exist before contacting the remote.
  local -a bundle=(
    "$install_dir/install-server.sh"
    "$install_dir/session-manager.zsh"
    "$install_dir/session-manager-lib.zsh"
    "$install_dir/ghostty-zmx-remote-layout"
    "$install_dir/terminfo/xterm-ghostty.terminfo"
  )
  local f
  for f in "${bundle[@]}"; do
    [[ -r "$f" ]] || { print -u2 "ghostty-zmx install-server: missing local file $f"
      print -u2 "Run ghostty-zmx-install --yes on this laptop first."; return 1 }
  done

  # Build a no-pty transport argv for the bootstrap. ssh needs -T before the
  # host so it does not try to allocate a pty for the piped command; tsh ssh
  # does not support -T/-t and is non-interactive when a command arg is present.
  # Drop any -t/-tt/--tty from the stored prefix, and for ssh insert -T right
  # after the `ssh` token if no -T is already present.
  local -a notty_argv=() rest=()
  local is_tsh=0 have_T=0 arg
  if [[ "${transport_argv[1]:-}" == "tsh" && "${transport_argv[2]:-}" == "ssh" ]]; then
    is_tsh=1
    notty_argv=(tsh ssh)
  else
    notty_argv=(ssh)
  fi
  for (( i=2; i<=${#transport_argv}; i++ )); do
    arg="${transport_argv[$i]}"
    [[ "$is_tsh" -eq 1 && "$i" -eq 2 ]] && continue  # skip the `ssh` after `tsh`
    case "$arg" in
      -t|-tt|--tty) ;;  # drop; we want no-pty
      -T) [[ $is_tsh -eq 0 ]] && { have_T=1 } ;;
      *) rest+=("$arg") ;;
    esac
  done
  [[ $is_tsh -eq 0 && $have_T -eq 0 ]] && notty_argv+=(-T)
  notty_argv+=("${rest[@]}")

  # Strip a user@ prefix for display only.
  local display_host="${host_target##*@}"
  print "ghostty-zmx: bootstrapping server install on $display_host..."

  # Bundle the four files into a tarball, stripping macOS metadata.
  # Pipe to the remote: mktemp -d, extract, run install-server.sh --yes, cleanup.
  # The remote command is a single quoted string so ssh passes it to the remote
  # shell. We use a fixed temp dir name under /tmp to keep the remote command
  # simple (mktemp -d output parsing over ssh is fragile).
  local tmpdir="/tmp/ghostty-zmx-server-install.$$"
  local -a remote_cmd=(
    "set -e"
    "tmpdir='$tmpdir'"
    "rm -rf \"\$tmpdir\""
    "mkdir -p \"\$tmpdir\""
    "cd \"\$tmpdir\""
    "tar xzf -"
    "./install-server.sh --yes"
    "rc=$?"
    "cd /"
    "rm -rf \"\$tmpdir\""
    "exit \$rc"
  )
  local remote_script="${(j:;:)remote_cmd}"

  _gzmx_wdebug "install-server host=$display_host tmpdir=$tmpdir transport=${notty_argv[*]}"

  # Bundle the files into a tarball, stripping macOS metadata.
  # install-server.sh resolves its siblings via repo_dir=${0:A:h}, so the tarball
  # must lay out: install-server.sh, session-manager.zsh, session-manager-lib.zsh,
  # ghostty-zmx-remote-layout, terminfo/xterm-ghostty.terminfo (with the subdir).
  # --no-mac-metadata + --format ustar + COPYFILE_DISABLE avoid ._ AppleDouble
  # files and LIBARCHIVE.xattr warnings that GNU tar on the remote would emit.
  COPYFILE_DISABLE=1 tar --no-mac-metadata --format ustar -czf - \
    -C "$install_dir" \
    install-server.sh \
    session-manager.zsh \
    session-manager-lib.zsh \
    ghostty-zmx-remote-layout \
    terminfo/xterm-ghostty.terminfo 2>/dev/null \
    | "${notty_argv[@]}" "$remote_script"
  local rc=$?
  if [[ $rc -eq 0 ]]; then
    print "ghostty-zmx: server install complete on $display_host."
    print "ghostty-zmx: remote panes from this laptop will now attach to zmx sessions on $display_host."
  else
    print -u2 "ghostty-zmx: server install failed on $display_host (exit $rc)."
  fi
  return $rc
}

mode="${1:-}"
case "$mode" in
  projection) shift ;;
  install-server) shift; _gzmx_install_server "$@"; exit $? ;;
  install) shift; exec "${0:A:h}/install.sh" "$@" ;;
  uninstall) shift; exec "${0:A:h}/uninstall.sh" "$@" ;;
  -h|--help|help)
    print "Usage: ghostty-zmx <mode> [options]"
    print ""
    print "Modes:"
    print "  projection     Run as a remote-zmx projection surface (used by the manager)."
    print "  install        Configure ghostty-zmx on this laptop (refresh after upgrade)."
    print "  uninstall      Remove ghostty-zmx from this laptop."
    print "  install-server Bootstrap ghostty-zmx server-side files on a remote host."
    print ""
    print "  ghostty-zmx projection --host <host> --workspace <ws> --session <gzr> -- <transport...> 'zmx attach <gzr>'"
    print "  ghostty-zmx install [--yes]"
    print "  ghostty-zmx uninstall [--yes]"
    print "  ghostty-zmx install-server <host> [-- yes]"
    print "  ghostty-zmx install-server -- <transport...> <host>   (e.g. tsh ssh -i key pier@host)"
    exit 0 ;;
  *) print -u2 "ghostty-zmx: unknown mode '$mode' (expected 'projection', 'install', 'uninstall', or 'install-server')"; exit 2 ;;
esac

host="" workspace="" session=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) host="$2"; shift 2 ;;
    --workspace) workspace="$2"; shift 2 ;;
    --session) session="$2"; shift 2 ;;
    --) shift; break ;;
    --*) print -u2 "ghostty-zmx: unknown option $1"; exit 2 ;;
    *) break ;;
  esac
done

[[ -n "$host" && -n "$session" ]] || { print -u2 "ghostty-zmx: --host and --session are required"; exit 2; }
[[ $# -gt 0 ]] || { print -u2 "ghostty-zmx: transport command missing after --"; exit 2; }

export GHOSTTY_ZMX_PROJECTION=1
export GHOSTTY_ZMX_PROJECTION_HOST="$host"
export GHOSTTY_ZMX_PROJECTION_SESSION="$session"
[[ -n "$workspace" ]] && export GHOSTTY_ZMX_PROJECTION_WORKSPACE="$workspace"

# OSC 2 (window title) + OSC 0 (icon title) markers so the projection window is
# identifiable and distinguishable from local panes.
print -n $'\e]2;ghostty-zmx: '"$host"' ('"$session"')\a'
print -n $'\e]0;gzr\a'

# Write the remote-layout row BEFORE attaching. This must run from the
# projection surface's own command context (not the widget's zle context) —
# a successful `add` from the widget triggers the Ghostty tip-build
# multiplication bug. The wrapper is the surface's own command, so its ssh
# is safe. Parse the session name (gzr-<ws>-<win>-<tab>-<pane>) for the ids.
# The transport argv is $@; build a no-pty version by dropping -t/-tt/--tty
# and adding -T.
if [[ "$session" == gzr-* ]]; then
  local _rest="${session#gzr-}"
  local _ws="${_rest%%-*}"
  _rest="${_rest#*-}"
  local _win="${_rest%%-*}"
  _rest="${_rest#*-}"
  local _tab="${_rest%%-*}"
  local _pane="${_rest#*-}"
  local -a _notty=()
  local _have_t=0 _is_tsh=0 _arg
  if [[ "${@[1]}" == "tsh" && "${@[2]:-}" == "ssh" ]]; then
    _is_tsh=1
  fi
  for _arg in "$@"; do
    case "$_arg" in
      -t|-tt|--tty) ;;
      -T) [[ "$_is_tsh" -eq 0 ]] && { _notty+=(-T); _have_t=1 } ;;
      *) _notty+=("$_arg") ;;
    esac
  done
  [[ "$_is_tsh" -eq 1 || "$_have_t" -eq 1 ]] || _notty+=(-T)
  # Drop the remote command arg (the 'zmx attach ...' last arg) for the add call.
  local -a _add_argv=()
  local _dropped_cmd=0 _remote_zmx="zmx"
  for _arg in "${_notty[@]}"; do
    if [[ "$_arg" == *"zmx attach "* ]]; then
      _dropped_cmd=1
      _remote_zmx="${_arg%% attach *}"
    else
      _add_argv+=("$_arg")
    fi
  done
  # Write the layout row with state=present so other clients' pollers can
  # discover and project this session. (An earlier revision wrote
  # state=opening here as a workaround for a suspected Ghostty tip-build
  # window-multiplication bug; that root cause was disproven — the
  # multiplication was caused by surviving orphaned poller shells, not by
  # the present row. See changelog
  # 2026-07-01-v0-2-multiplication-root-cause-orphaned-poller-shells.)
  if [[ "$_dropped_cmd" -eq 1 ]]; then
    "${_add_argv[@]}" '$HOME/.config/ghostty-zmx/ghostty-zmx-remote-layout' add "$_ws" "$_win" "$_tab" "$_pane" "$session" - root 1 present >/dev/null 2>&1 || true
  fi
fi

# Remote reboot scrollback restore: if the remote zmx session is missing
# (remote host rebooted, zmx daemon lost) and a local scrollback snapshot
# exists, inject the saved scrollback into a fresh remote session before
# attaching. The snapshot is namespaced by host under
# ~/.local/state/ghostty-zmx/history/<host>/<session>.txt. Mirrors the v0.1
# local reboot scrollback restore, but the zmx run/print calls run over ssh -T
# (no pty). Quoting: the snapshot is base64-encoded locally and decoded on the
# remote so multi-line text / special chars survive the local-zsh -> ssh ->
# remote-zsh -> zmx hop without shell-expansion issues.
if [[ "$session" == gzr-* ]]; then
  local _hist_file="${GHOSTTY_ZMX_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/ghostty-zmx}/history/$host/${session}.txt"
  if [[ -s "$_hist_file" ]]; then
    _gzmx_wdebug "reboot-restore host=$host session=$session snapshot=$_hist_file"
    # Check whether the remote session already exists (reattach, not reboot).
    # Use _add_argv (transport argv without the 'zmx attach ...' remote command
    # arg) so the injection ssh calls don't carry the attach command. ssh joins
    # trailing args into the remote command string, so inline the session name
    # directly (hex+dashes — shell-safe).
    if ! "${_add_argv[@]}" "$_remote_zmx list --short 2>/dev/null | grep -qxF $session" 2>/dev/null; then
      _gzmx_wdebug "reboot-restore session missing — creating fresh + injecting host=$host session=$session"
      # Session missing: create a fresh one, then inject banner + snapshot.
      "${_add_argv[@]}" "$_remote_zmx run $session true >/dev/null 2>&1" 2>/dev/null || true
      local _banner='[ghostty-zmx restored saved scrollback from a previous boot; process state was not restored]'
      # zmx print requires \r\n line endings (plain \n does not render in the
      # session display). Convert the banner + snapshot before base64 encoding.
      { print -r -- "$_banner"; cat "$_hist_file"; } | sed 's/$/\r/' | base64 | tr -d '\n' | \
        "${_add_argv[@]}" "b64=\$(cat); printf \"%s\" \"\$b64\" | base64 -d | $_remote_zmx print $session" 2>/dev/null || true
      _gzmx_wdebug "reboot-restore injected host=$host session=$session"
      print -n $'\e]2;ghostty-zmx: restored '"$host"' ('"$session"')\a'
    else
      _gzmx_wdebug "reboot-restore session exists — reattach host=$host session=$session"
    fi
  fi
fi

# Run the transport in the FOREGROUND via exec so it keeps the controlling TTY.
# The layout row was already written state=present above; the transport's
# remote `zmx attach` attaches to the remote session. This runs as the
# surface's own command (the ssh -t), so the attach happens on the remote
# side with a real pty.
# Backgrounding ssh ("$@" &) detaches it from the TTY, so `ssh -t` cannot
# allocate a pseudo-terminal ("Pseudo-terminal will not be allocated because
# stdin is not a terminal"), the remote `zmx attach` runs non-interactively and
# exits immediately, and Ghostty recloses the surface (leaving a pid=0 ghost).
# exec preserves the TTY and the env markers set above; the wrapper process is
# replaced by the transport, so the `--session <gzr>` marker leaves `ps args`, but
# the descendant-walk scan still matches `zmx attach <gzr>` in the transport's
# args and GHOSTTY_ZMX_PROJECTION_SESSION in its env.
exec "$@"
