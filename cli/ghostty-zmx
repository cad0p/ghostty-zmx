#!/bin/zsh -f
# ghostty-zmx CLI — v0.2 projection wrapper.
# -f: skip rc files so the wrapper never sources .zprofile/.zshrc (and thus never
# sources session-manager.zsh). Without -f, Ghostty runs the command via
# `login -c "exec -l <cmd>"` and `exec -l` makes it a login shell, which sources
# .zprofile → session-manager.zsh, re-running auto-attach/widget/poller inside
# the projection pane and causing window multiplication.
#
# Usage:
#   ghostty-zmx projection --host <host> --workspace <ws> --session <gzr> -- <transport...> 'zmx attach <gzr>'
#
# The wrapper stays alive as the parent of the transport command so that
# ghostty-zmx can observe and clean up projections by process args. It sets
# env markers (GHOSTTY_ZMX_PROJECTION*) and an OSC window title, runs the
# transport as a child, forwards termination signals, and exits with the
# child's status. The generic CLI name is intentional so v0.3 can extend it
# with workspace attach/detach/list commands without a second binary.
#
# This is sourced/launched as a surface `command` by ghostty-zmx; it never
# sources .zshrc or runs a local shell, so local auto-attach is bypassed.

emulate -L zsh
setopt no_sh_word_split

typeset -r _GZMX_WRAPPER_DIR="${0:A:h}"
# Install scripts (install.sh, install-dev.sh, uninstall.sh) live one level up
# from cli/ (the install-dir root or the repo root in a checkout).
typeset -r _GZMX_INSTALL_ROOT="${_GZMX_WRAPPER_DIR:h}"

# Debug logging to the state debug.log (mirrors the manager's _ghostty_zmx_debug).
_gzmx_wdebug() {
  [[ "${GHOSTTY_ZMX_DEBUG:-0}" == "1" ]] || return 0
  local _d="${GHOSTTY_ZMX_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/ghostty-zmx}"
  mkdir -p "$_d" 2>/dev/null
  local _log="$_d/debug.log"
  # Rotate if over the cap (mirrors _ghostty_zmx_debug_rotate in the lib;
  # inlined because the wrapper runs under zsh -f and must not source the lib).
  local _cap="${GHOSTTY_ZMX_DEBUG_LOG_MAX_BYTES:-1048576}"
  [[ "$_cap" == <-> ]] || _cap=1048576
  if [[ -f "$_log" ]]; then
    local _sz
    _sz=$(stat -f %z "$_log" 2>/dev/null || stat -c %s "$_log" 2>/dev/null) || _sz=0
    if [[ "$_sz" -gt "$_cap" ]]; then
      mv -f "$_log" "${_log}.1" 2>/dev/null || true
      local _n
      for (( _n=2; _n<=9; _n++ )); do
        [[ -f "${_log}.${_n}" ]] && rm -f "${_log}.${_n}" 2>/dev/null || true
      done
    fi
  fi
  print -r -- "$(date -u '+%Y-%m-%dT%H:%M:%SZ') wrapper $*" >> "$_log"
}

# Subcommand implementations live in sibling files to keep this wrapper a
# thin dispatcher. Each is sourced on demand (never from .zshrc/.zprofile;
# the wrapper runs under `zsh -f`). They rely on $_GZMX_WRAPPER_DIR (defined
# above) and, for install-server, $_gzmx_wdebug (defined above).

mode="${1:-}"
case "$mode" in
  projection) shift ;;
  install-server) shift; source "$_GZMX_WRAPPER_DIR/install-server" 2>/dev/null || { print -u2 "ghostty-zmx: install-server not found in $_GZMX_WRAPPER_DIR"; exit 127; }; _gzmx_install_server "$@"; exit $? ;;
  install) shift; exec "$_GZMX_INSTALL_ROOT/install.sh" "$@" ;;
  install-dev) shift; exec "$_GZMX_INSTALL_ROOT/install-dev.sh" "$@" ;;
  uninstall) shift; exec "$_GZMX_INSTALL_ROOT/uninstall.sh" "$@" ;;
  debug) shift; source "$_GZMX_WRAPPER_DIR/debug" 2>/dev/null || { print -u2 "ghostty-zmx: debug not found in $_GZMX_WRAPPER_DIR"; exit 127; }; _gzmx_debug_subcommand "$@"; exit $? ;;
  -h|--help|help)
    print "Usage: ghostty-zmx <mode> [options]"
    print ""
    print "Modes:"
    print "  projection     Run as a remote-zmx projection surface (used by the manager)."
    print "  install        Configure ghostty-zmx on this laptop (refresh after upgrade)."
    print "  install-dev    One-command dev onboarding against Ghostty-tip (isolated from stable)."
    print "  uninstall      Remove ghostty-zmx from this laptop."
    print "  install-server Bootstrap ghostty-zmx server-side files on a remote host."
    print "  debug          Enable/disable/show debug logging, or print a bug-report context block."
    print ""
    print "  ghostty-zmx projection --host <host> --workspace <ws> --session <gzr> -- <transport...> 'zmx attach <gzr>'"
    print "  ghostty-zmx install [--yes]"
    print "  ghostty-zmx install-dev [--yes] [--update-tip]"
    print "  ghostty-zmx uninstall [--yes]"
    print "  ghostty-zmx install-server <host> [-- yes]"
    print "  ghostty-zmx install-server -- <transport...> <host>   (e.g. tsh ssh -i key pier@host)"
    print "  ghostty-zmx debug on|off|status|log [--lines N]"
    exit 0 ;;
  *) print -u2 "ghostty-zmx: unknown mode '$mode' (expected 'projection', 'install', 'install-dev', 'uninstall', 'install-server', or 'debug')"; exit 2 ;;
esac

host="" workspace="" session=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) host="$2"; shift 2 ;;
    --workspace) workspace="$2"; shift 2 ;;
    --session) session="$2"; shift 2 ;;
    --) shift; break ;;
    --*) print -u2 "ghostty-zmx: unknown option $1"; exit 2 ;;
    *) break ;;
  esac
done

[[ -n "$host" && -n "$session" ]] || { print -u2 "ghostty-zmx: --host and --session are required"; exit 2; }
[[ $# -gt 0 ]] || { print -u2 "ghostty-zmx: transport command missing after --"; exit 2; }

export GHOSTTY_ZMX_PROJECTION=1
export GHOSTTY_ZMX_PROJECTION_HOST="$host"
export GHOSTTY_ZMX_PROJECTION_SESSION="$session"
[[ -n "$workspace" ]] && export GHOSTTY_ZMX_PROJECTION_WORKSPACE="$workspace"

# OSC 2 (window title) + OSC 0 (icon title) markers so the projection window is
# identifiable and distinguishable from local panes.
print -n $'\e]2;ghostty-zmx: '"$host"' ('"$session"')\a'
print -n $'\e]0;gzr\a'

# Write the remote-layout row BEFORE attaching. This must run from the
# projection surface's own command context (not the widget's zle context) —
# a successful `add` from the widget triggers the Ghostty tip-build
# multiplication bug. The wrapper is the surface's own command, so its ssh
# is safe. Parse the session name (gzr-<ws>-<win>-<tab>-<pane>) for the ids.
# The transport argv is $@; build a no-pty version by dropping -t/-tt/--tty
# and adding -T.
if [[ "$session" == gzr-* ]]; then
  local _rest="${session#gzr-}"
  local _ws="${_rest%%-*}"
  _rest="${_rest#*-}"
  local _win="${_rest%%-*}"
  _rest="${_rest#*-}"
  local _tab="${_rest%%-*}"
  local _pane="${_rest#*-}"
  local -a _notty=()
  local _have_t=0 _is_tsh=0 _arg
  # Strip the path prefix: the widget resolves tsh/ssh to absolute paths
  # (ghostty_zmx_resolve_transport_path), so argv[1] may be /usr/local/bin/tsh
  # rather than bare "tsh". ${1##*/} extracts the basename (like the :t
  # modifier). Without this, _is_tsh stays 0 for a tsh invoked via absolute
  # path, -T gets appended to the `tsh ssh ... add` call, tsh rejects -T, and
  # the remote-layout row is never written — silently breaking Cmd-Q+reopen
  # restore for every tsh host. See e2e/17-tsh-cmdq-restore.zsh.
  if [[ "${1##*/}" == "tsh" && "${2:-}" == "ssh" ]]; then
    _is_tsh=1
    # Set TERM=dumb BEFORE the `add` call below: tsh gates its OSC 11 / CSI 6n
    # probe on the LOCAL TERM, and the `add` is itself a `tsh ssh` invocation.
    # If TERM is not dumb here, tsh emits the probe and (for the mock-tsh E2E
    # fixture) the TERM=dumb assertion rejects the call with rc=2, so the
    # remote-layout row is never written. The later `exec "$@"` re-affirms
    # TERM=dumb for the attach; setting it here covers both paths.
    export TERM=dumb
    _gzmx_wdebug "projection: set TERM=dumb for tsh transport (before add + attach)"
  fi
  for _arg in "$@"; do
    case "$_arg" in
      -t|-tt|--tty) ;;
      -T) [[ "$_is_tsh" -eq 0 ]] && { _notty+=(-T); _have_t=1 } ;;
      *) _notty+=("$_arg") ;;
    esac
  done
  [[ "$_is_tsh" -eq 1 || "$_have_t" -eq 1 ]] || _notty+=(-T)
  # Drop the remote command arg (the 'zmx attach ...' last arg) for the add call.
  local -a _add_argv=()
  local _dropped_cmd=0 _remote_zmx="zmx"
  for _arg in "${_notty[@]}"; do
    if [[ "$_arg" == *"zmx attach "* ]]; then
      _dropped_cmd=1
      _remote_zmx="${_arg%% attach *}"
    else
      _add_argv+=("$_arg")
    fi
  done
  # Write the layout row with state=present so other clients' pollers can
  # discover and project this session. (An earlier revision wrote
  # state=opening here as a workaround for a suspected Ghostty tip-build
  # window-multiplication bug; that root cause was disproven — the
  # multiplication was caused by surviving orphaned poller shells, not by
  # the present row. See changelog
  # 2026-07-01-v0-2-multiplication-root-cause-orphaned-poller-shells.)
  if [[ "$_dropped_cmd" -eq 1 ]]; then
    "${_add_argv[@]}" '$HOME/.config/ghostty-zmx/cli/remote-layout' add "$_ws" "$_win" "$_tab" "$_pane" "$session" - root 1 present >/dev/null 2>&1 || _gzmx_wdebug "wrapper add FAILED rc=$? host=$host session=$session"
  fi
fi

# Suppress tsh's terminal-capability probing. The Teleport `tsh` client emits
# an OSC 11 (foreground-color) and CSI 6n (cursor-position) query to the LOCAL
# terminal on every SSH connection (confirmed: `tsh ssh -T host /bin/true`
# emits both; plain OpenSSH emits neither). Ghostty answers; in a projection
# pane the local pty IS the zmx pty, so the response echoes into scrollback as
# stray `11;rgb:...1R` characters. tsh gates this probe on the LOCAL TERM:
# with TERM=dumb it emits zero queries.
#
# tsh DOES forward the local TERM to the remote over a pty (-t), so the remote
# interactive shell inherits TERM=dumb. That would break remote curses/tui
# apps and oh-my-zsh's OSC 7 cwd emitter (its `case "$TERM"` gate rejects
# `dumb`). The server installer's remote-env block (install-server.sh)
# restores TERM=xterm-ghostty (or xterm-256color) in the remote ~/.zshrc,
# gated on SSH_CONNECTION + TERM being dumb/empty, so the remote shell gets a
# working TERM regardless. This keeps the local probe suppression effective
# without crippling the remote shell. See Goldmine
# 2026-07-04-osc-leak-live-verification-csi-6n-emitter-hunt.
if [[ "${1##*/}" == "tsh" && "${2:-}" == "ssh" ]]; then
  export TERM=dumb
fi
# Run the transport in a reconnect loop (autossh-inspired) so a dropped
# ssh/tsh connection reattaches to the surviving remote zmx session instead
# of leaving the pane at Ghostty's close prompt. TERM=dumb above persists
# across loop iterations via env inheritance. GHOSTTY_ZMX_RECONNECT=0 is the
# kill switch: it restores the original `exec "$@"` behavior (for bisection
# or users who prefer manual reconnect) while still running the cold-start
# reboot-restore check so the Cmd-Q/reopen scrollback-restore feature is
# preserved. See cli/projection-loop.
if [[ "${GHOSTTY_ZMX_RECONNECT:-1}" == "1" ]]; then
  source "$_GZMX_WRAPPER_DIR/projection-loop" || { print -u2 "ghostty-zmx: projection-loop not found in $_GZMX_WRAPPER_DIR (incomplete install)"; exit 127; }
else
  typeset _GZMX_PROJECTION_COLD_START_ONLY=1
  source "$_GZMX_WRAPPER_DIR/projection-loop" || { print -u2 "ghostty-zmx: projection-loop not found in $_GZMX_WRAPPER_DIR (incomplete install)"; exit 127; }
fi
